# Copiá este archivo a .env y completá los valores. Nunca subas .env al repo.
# App ID de Cavos (testnet) desde https://cavos.xyz dashboard
EXPO_PUBLIC_CAVOS_APP_ID=
# Dominio web de la app: https://pago.meteorito.app
# rpId para passkeys (default en código: meteorito-mvp.vercel.app; NO cambiar sin migrar passkeys)
EXPO_PUBLIC_CAVOS_RP_ID=meteorito-mvp.vercel.app
# Supabase (link de venta)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Tipo de cambio de referencia para mostrar USD (opcional)
EXPO_PUBLIC_CRC_PER_USD=505

# --- Server-only (Vercel env, SIN prefijo EXPO_PUBLIC_) ---
STELLAR_NETWORK=testnet
TW_API_BASE=https://dev.api.trustlesswork.com
TW_API_KEY=
TW_PROTOCOL_FEE=0.003
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEPLOYER_SECRET=
TREASURY_SECRET=
APPROVER_SECRET=
RELEASE_SIGNER_SECRET=
SERVICE_SECRET=            # solo si SERVICE_PROVIDER_MODE=backend
SERVICE_PROVIDER_MODE=seller   # seller | backend (fallback)
PLATFORM_PUBLIC=
PLATFORM_SECRET=           # solo fee-bumps
FEEBUMP_MAX_INNER_FEE=20000000
DISPUTE_RESOLVER_PUBLIC=
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
CRC_USDC_RATE=510
# Ventana de liberación automática tras el envío, en minutos (default 1440 = 24 h). Testnet: p.ej. 10 para QA.
AUTO_RELEASE_MINUTES=1440
PIN_PEPPER=
CRON_SECRET=
CAVOS_JWKS_URL=https://cavos.xyz/.well-known/jwks.json
CAVOS_JWT_ISSUERS=https://cavos.app/firebase,https://accounts.google.com,https://appleid.apple.com
CAVOS_JWT_AUDIENCE=

# --- Cliente ---
EXPO_PUBLIC_CRC_USDC_RATE=510
# PostHog (Quantz, proyecto 658120). Key pública de proyecto (phc_...), segura en cliente.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server (api/): reusa la misma key; ANALYTICS_DISABLED=1 para apagar
POSTHOG_KEY=

# Recuperación social Cavos (enclave). Activar SOLO tras habilitarla en el dashboard de Cavos (1 proveedor + orígenes).
EXPO_PUBLIC_CAVOS_SOCIAL_RECOVERY=false

# Ventana para renovar un token Cavos vencido con prueba de la wallet ligada (días, default 7, máx 30).
SESSION_GRACE_DAYS=7
